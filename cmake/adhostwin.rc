// adhostwin.exe resources: the manifest (adhostwin.manifest says what it
// leaves out, and why) and version information. Attached to the adhostwin
// target by the top-level CMakeLists.txt, so host/core's build stays as it is.
#include <winresrc.h>

#include "adw_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "adhostwin.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ADW_VERSION_RC
PRODUCTVERSION ADW_VERSION_RC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Long After Dark emulator host"
      VALUE "FileVersion", ADW_VERSION_RC_STRING
      VALUE "InternalName", "adhostwin"
      VALUE "LegalCopyright", ADW_COPYRIGHT
      VALUE "OriginalFilename", "adhostwin.exe"
      VALUE "ProductName", ADW_PRODUCT_NAME
      VALUE "ProductVersion", ADW_VERSION_RC_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
