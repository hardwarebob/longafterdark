// adimport.exe resources: the manifest (Common Controls 6 for the themed
// windows of gui/, per-monitor DPI v2, asInvoker), the icon (the moon tile
// LongAfterDark.scr has, drawn at build time: see CMakeLists.txt) and version
// information (adw_version.h, generated: one version for every program).
#include <winresrc.h>

#include "adw_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "adimport.manifest"

// The first icon: what Explorer shows for the file.
1 ICON "adimport.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ADW_VERSION_RC
PRODUCTVERSION ADW_VERSION_RC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Long After Dark importer"
      VALUE "FileVersion", ADW_VERSION_RC_STRING
      VALUE "InternalName", "adimport"
      VALUE "LegalCopyright", ADW_COPYRIGHT
      VALUE "OriginalFilename", "adimport.exe"
      VALUE "ProductName", ADW_PRODUCT_NAME
      VALUE "ProductVersion", ADW_VERSION_RC_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
